{{- $indexEntries := slice -}}
{{- range $index, $element := (where .Site.RegularPages "Kind" "page") -}}
  {{ with $element.Plain }}
    {{- $indexEntries = $indexEntries | append (dict "id" $index "title" $element.Title "uri" $element.Permalink "tags" $element.Params.tags "section" $element.Section "content" $element.Plain "description" $element.Description) -}}
  {{ end }}
{{- end -}}
{{- $indexEntries | jsonify -}}